<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aladdoalhurof.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>أسرار وخصائص علم الحروف</name>
    <description>تطبيق شامل لعلم الحروف والجفر والأوفاق وتفسير الأحلام والكاشف القرآني</description>
    <author email="abdulmalik@alqaim.org" href="https://alqaim.org">عبد الملك علي الحوثي — مؤسسة القائم الحجة</author>

    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- إعدادات Android -->
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="android-compileSdkVersion" value="36" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#1A237E" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="#1A237E" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <preference name="FullScreen" value="false" />
</widget>
